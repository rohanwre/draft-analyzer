# Copy to terraform.tfvars (gitignored) and fill in real values. db_host must be a
# MySQL host reachable from Lambda over the public internet.
aws_region      = "us-east-1"
db_host         = ""
db_port         = "3306"
db_user         = ""
db_password     = ""
db_name         = ""
allowed_origins = "http://localhost:5173"
