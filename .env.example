# Copy this file to .env and fill in real values.
# In production (Railway/Render), set these as environment variables in the
# platform's dashboard instead of committing a .env file.

DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=fantasy_draft_analyzer

# Comma-separated list of frontend origins allowed to call this API.
# Include your deployed Vercel URL once you have one, e.g.:
# ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# Snowflake - only needed to run load_snowflake.py. Sign up for a free trial at
# signup.snowflake.com; SNOWFLAKE_ACCOUNT is the identifier from your account URL
# (e.g. xy12345.us-east-1). WAREHOUSE/DATABASE/SCHEMA default to COMPUTE_WH/
# DRAFT_ANALYZER/PUBLIC if unset - create a DRAFT_ANALYZER database first (or point
# these at whatever you named it).
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
# If MFA is enforced on the account (the default for new ones), password logins from
# scripts are rejected - use key-pair auth instead. Takes precedence over the password.
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=DRAFT_ANALYZER
SNOWFLAKE_SCHEMA=PUBLIC

# Airflow (docker-compose.airflow.yml) - all optional.
# Slack or Discord incoming-webhook URL for failure/retry/slow-stage alerts; without it
# alerts only go to the Airflow task logs.
ALERT_WEBHOOK_URL=
# MySQL as seen from inside the containers - defaults to host.docker.internal (this
# machine) with DB_USER/DB_PASSWORD. Only set these for a MySQL somewhere else.
AIRFLOW_DB_HOST=
AIRFLOW_DB_USER=
AIRFLOW_DB_PASSWORD=
